cabal-version:      2.4
name:               terminal-size
version:            0.3.4
synopsis:           wasm32-wasi stand-in for terminal-size
description:
  The real package asks for the window size with an ioctl, which WASI lacks.
  This one always answers Nothing ("not a terminal"), which is exactly what
  native hledger sees when its stdout is a pipe, so report layout matches a
  native run with redirected output.
license:            GPL-3.0-or-later
build-type:         Simple

library
  exposed-modules:  System.Console.Terminal.Size
  build-depends:    base >=4 && <5
  default-language: Haskell2010
